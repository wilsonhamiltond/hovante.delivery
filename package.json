{
  "name": "hovante.delivery",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "libphonenumber-js": "^1.13.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "node -e \"require('fs').rmSync('.env.local',{force:true})\" && expo start",
    "start:prod": "node -e \"require('fs').copyFileSync('.env.android','.env.local')\" && expo start --clear",
    "dev:android": "node -e \"require('fs').copyFileSync('.env.android','.env.local')\" && expo start --dev-client --clear",
    "android": "node -e \"require('fs').rmSync('.env.local',{force:true})\" && expo start --android",
    "ios": "node -e \"require('fs').rmSync('.env.local',{force:true})\" && expo start --ios",
    "web": "node -e \"require('fs').rmSync('.env.local',{force:true})\" && expo start --web",
    "start:web": "node -e \"require('fs').copyFileSync('.env.web','.env.local')\" && expo start --clear",
    "android:prod": "node -e \"require('fs').copyFileSync('.env.android','.env.local')\" && expo start --clear --android",
    "ios:prod": "node -e \"require('fs').copyFileSync('.env.ios','.env.local')\" && expo start --clear --ios",
    "web:prod": "node -e \"require('fs').copyFileSync('.env.web','.env.local')\" && expo start --clear --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "_comment": "The .env.local juggling runs through node instead of rm/cp: npm shells out to cmd.exe on Windows, which has neither."
  },
  "jest": {
    "preset": "jest-expo"
  },
  "private": true
}
