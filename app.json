{
  "expo": {
    "name": "Volao",
    "slug": "hovante-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon.appiconset/AppIcon-1024.png",
    "scheme": "hovantedelivery",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/ios/AppIcon.appiconset/AppIcon-1024.png"
    },
    "android": {
      "package": "com.volao.delivery",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E8FE1",
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/web/favicon-512x512.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hovante Delivery usa tu ubicación para seleccionar dónde entregar tu pedido."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Volao usa tus fotos para que elijas tu imagen de perfil.",
          "cameraPermission": "Volao usa la cámara para que tomes tu imagen de perfil."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02c6c517-ee0f-4de1-a0b8-2b79db013be3"
      }
    }
  }
}
